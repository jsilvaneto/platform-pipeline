# ==============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO (EXEMPLO GENÉRICO)
# ==============================================================================

# Versão do Projeto
APP_VERSION=1.0.1

# Ambiente: development | production | test
ENVIRONMENT=development

# Segredo de assinatura de tokens JWT (substitua por um segredo forte em produção)
SECRET_KEY=change_this_to_a_super_secret_key_minimum_32_characters_long

# Algoritmo de criptografia do token
ALGORITHM=HS256

# Validade do token em minutos (ex: 43200 = 30 dias)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Porta do Backend (Padrão: 8000)
BACKEND_PORT=8000

# Porta do Frontend (Padrão: 5173 para dev / 80 mapeada para 5173 no docker)
FRONTEND_PORT=5173

# ==============================================================================
# BANCO DE DADOS POSTGRESQL
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet

# URL completa (opcional, sobrescreve os parâmetros individuais se informada)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wallet

# Diretório para persistência de uploads/arquivos (opcional)
UPLOADS_DIR=./data/uploads

# ==============================================================================
# BACKUP AUTOMATIZADO E DISASTER RECOVERY (GOOGLE DRIVE)
# ==============================================================================
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=seu_folder_id_do_google_drive_aqui
BACKUP_RETENTION_DAYS=30

