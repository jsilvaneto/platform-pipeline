# ==============================================================================
# WALLET - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha os valores de acordo com seu ambiente:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFICAÇÃO E VERSÃO DA APLICAÇÃO
# ------------------------------------------------------------------------------
APP_NAME=Wallet
APP_VERSION=1.2.0
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. SEGURANÇA E AUTENTICAÇÃO (JWT)
# ------------------------------------------------------------------------------
# IMPORTANTE: Gere uma chave segura aleatória com pelo menos 32 caracteres.
# Exemplo para gerar no Linux/bash: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_key_minimum_32_characters_long
ALGORITHM=HS256
# Tempo de expiração do token JWT em minutos (padrão: 43200 = 30 dias)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ------------------------------------------------------------------------------
# 3. CREDENCIAIS DO USUÁRIO ADMINISTRADOR PADRÃO (Seed Inicial)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 4. BANCO DE DADOS POSTGRESQL
# ------------------------------------------------------------------------------
# Para Docker Compose, POSTGRES_SERVER deve ser o nome do serviço 'postgres'.
# Para execução direta no host, use 'localhost'.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wallet

# URL completa de conexão assíncrona (opcional - gerada dinamicamente se omitida)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/wallet

# ------------------------------------------------------------------------------
# 5. PORTAS DOS SERVIÇOS (DOCKER COMPOSE)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 6. GESTÃO DE BACKUPS & GOOGLE DRIVE (DISASTER RECOVERY)
# ------------------------------------------------------------------------------
# Caminho para o arquivo JSON de credenciais da Conta de Serviço do Google Cloud.
# No Docker Compose, a pasta ./backups do host é mapeada para /app/backups.
# Portanto, salve o arquivo baixado do Google em ./backups/credentials.json
# ou use /app/credentials.json caso monte diretamente.
GOOGLE_APPLICATION_CREDENTIALS=/app/backups/credentials.json

# ID da pasta do Google Drive onde os snapshots serão armazenados.
# Obtenha na URL do Drive: https://drive.google.com/drive/folders/<FOLDER_ID>
# Exemplo: GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz12345
GOOGLE_DRIVE_FOLDER_ID=

# Retenção automática de backups em dias (os mais antigos que este limite são expurgados no Drive)
BACKUP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 7. FRONTEND (VITE)
# ------------------------------------------------------------------------------
# URL base da API se acessada de fora do container ou proxy reverso (opcional)
# VITE_API_URL=http://localhost:8000/api/v1
